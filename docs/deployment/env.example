# Stock Report - Production .env
# Copy to /opt/stockreport/.env and fill values

STOCK_CODE=
MAX_PAGES=3
PDF_DIR=/opt/stockreport/pdf

# Google Sign-In (optional - leave empty to use legacy admin login)
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS=
JWT_SECRET=
HEADLESS=true
PAGE_DELAY=1.5
DOWNLOAD_DELAY=0.5

# Google (optional - leave empty to disable sync)
GOOGLE_OAUTH_CREDENTIALS=./google_oauth_credentials.json
OAUTH_REDIRECT_URI=https://stockreport.tnsai.vn/oauth2callback
GOOGLE_DRIVE_FOLDER_ID=1ovUT6Qatvq2jsUuYLV757NEOIasLJEqh
GOOGLE_SHEET_FOLDER_ID=1ovUT6Qatvq2jsUuYLV757NEOIasLJEqh
